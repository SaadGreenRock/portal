# ---- Password gate (single operator) -------------------------------------
# Change this. It is the only thing standing between the internet and your vouchers.
PORTAL_PASSWORD=change-me

# Used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Backend ------------------------------------------------------------
# "local"    = SQLite file + files on disk under ./.data   (default, zero setup)
# "supabase" = Supabase Postgres + Supabase Storage        (for hosting / phone access)
BACKEND=local

# Only needed when BACKEND=supabase.
# Dashboard → Project Settings → API keys.
# Use the SECRET key (sb_secret_...), or the legacy service_role key.
# The publishable/anon key will NOT work: the tables have RLS enabled with no
# policies, so only a secret key can read them. Never expose this key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=vouchers

# ---- PDF rendering ------------------------------------------------------
# Nothing to configure. Vouchers are rendered to PDF in the operator's browser,
# so there is no Chromium to install and this deploys to Vercel as-is.
