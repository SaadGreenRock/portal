# ---- Password gate (single operator) -------------------------------------
# Change this. It is the only thing standing between the internet and your vouchers.
PORTAL_PASSWORD=change-me

# Used to sign the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How many minutes the portal may sit idle before it locks itself. Optional;
# 15 if unset, and clamped to between 1 minute and 24 hours.
#
# The window slides: real use pushes it out, so the clock only runs down when
# nobody is there. The browser warns a minute before and then takes the screen
# to the lock, and the cookie stops verifying on the server at the same instant
# whether the browser cooperates or not.
#
# Here rather than in code precisely so it can be changed without a deploy: the
# right number is a fact about the room the laptop sits in, not about the portal.
PORTAL_IDLE_MINUTES=15

# ---- Backend ------------------------------------------------------------
# "local"    = SQLite file + files on disk under ./.data   (default, zero setup)
# "supabase" = Supabase Postgres + Supabase Storage        (for hosting / phone access)
BACKEND=local

# Only needed when BACKEND=supabase.
# Dashboard → Project Settings → API keys.
# Use the SECRET key (sb_secret_...), or the legacy service_role key.
# The publishable/anon key will NOT work: the tables have RLS enabled with no
# policies, so only a secret key can read them. Never expose this key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=vouchers

# ---- Timezone -----------------------------------------------------------
# Convenience only, and safe to leave out.
#
# The zone the portal dates documents in is NOT this. It is stated in code, in
# PORTAL_TIMEZONE in src/lib/clock.ts, because a document number carries the
# month it was created in and is never reissued — so that answer must not depend
# on a variable a host could be missing.
#
# This just makes the machine's own clock agree with the portal's, so shell
# commands and host logs read in the same zone as the screens do.
TZ=Asia/Karachi

# ---- PDF rendering ------------------------------------------------------
# Nothing to configure. Vouchers are rendered to PDF in the operator's browser,
# so there is no Chromium to install and this deploys to Vercel as-is.
